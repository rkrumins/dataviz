# ── Synodic Graph Service ──────────────────────────────────────────────
# Stateless companion: provider discovery & connectivity testing.
# Serves on port 8001. No database access — takes params in request body.
# ──────────────────────────────────────────────────────────────────────
FROM python:3.14-slim AS base

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libffi-dev libpq-dev curl \
        libxml2-dev libxmlsec1-dev libxmlsec1-openssl xmlsec1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ /app/backend/

RUN addgroup --system synodic && adduser --system --ingroup synodic synodic
USER synodic

EXPOSE 8001

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD curl -sf http://localhost:8001/health || exit 1

# Fewer workers than viz — lightweight stateless service — but never 1:
# response serialization is CPU-bound ON the event loop, so a single
# worker lets one heavy graph response block every other request,
# including /health (the same wedge fixed in Dockerfile.viz).
ENV GUNICORN_WORKERS=2 \
    GUNICORN_TIMEOUT=120 \
    GUNICORN_GRACEFUL_TIMEOUT=30

CMD ["sh", "-c", "exec gunicorn backend.graph.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers ${GUNICORN_WORKERS} \
    --bind 0.0.0.0:8001 \
    --timeout ${GUNICORN_TIMEOUT} \
    --graceful-timeout ${GUNICORN_GRACEFUL_TIMEOUT} \
    --access-logfile -"]
