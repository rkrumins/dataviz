{
  "cases": [
    {
      "name": "belongs-to-defaults-child-to-parent",
      "summary": "CONTAINMENT child_is_source: BELONGS_TO with a null direction points child->parent, while CONTAINS with a null direction points parent->child.",
      "view": {
        "content": { "entityScope": "curated" },
        "layout": {
          "referenceLayout": {
            "layers": [{ "id": "a", "name": "A", "order": 0, "entityTypes": [] }],
            "assignments": { "d": { "layerId": "a", "inheritsChildren": true } }
          }
        }
      },
      "ontology": { "containment": { "CONTAINS": null, "BELONGS_TO": null } },
      "nodes": [{ "urn": "d" }, { "urn": "t" }, { "urn": "u" }],
      "edges": [
        { "source": "t", "target": "d", "edgeType": "BELONGS_TO" },
        { "source": "d", "target": "u", "edgeType": "CONTAINS" }
      ],
      "expect": {
        "d": { "layerId": "a", "source": "explicit" },
        "t": { "layerId": "a", "source": "inherited", "inheritedFrom": "d" },
        "u": { "layerId": "a", "source": "inherited", "inheritedFrom": "d" }
      }
    },
