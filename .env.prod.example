# ══════════════════════════════════════════════════════════════════════
# Synodic — Self-Host / Production Env Template
# ══════════════════════════════════════════════════════════════════════
# Copy to .env and edit before `./deploy.sh up`:
#   cp .env.prod.example .env
#   $EDITOR .env                     # set REPLACE_ME values
#   ./deploy.sh up
#
# The deploy preflight refuses to start if any REPLACE_ME value remains.
# ══════════════════════════════════════════════════════════════════════

# ── Postgres (management database) ──────────────────────────────────
# Change POSTGRES_PASSWORD. POSTGRES_USER / POSTGRES_DB can stay.
POSTGRES_USER=synodic
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=synodic
POSTGRES_PORT=5432

# ── Redis / FalkorDB (usually don't change) ─────────────────────────
REDIS_PORT=6380
FALKORDB_PORT=6379
FALKORDB_UI_PORT=3000
FALKORDB_GRAPH_NAME=nexus_lineage

# ── App ports (host-side) ───────────────────────────────────────────
VIZ_PORT=8000
GRAPH_PORT=8001
CONTROLPLANE_PORT=8091
FRONTEND_PORT=3080

# ── Auth — MUST CHANGE ──────────────────────────────────────────────
# Generate a strong JWT secret:
#   openssl rand -hex 48
JWT_SECRET_KEY=REPLACE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15

# Retired signing keys (comma-separated, most-recent first), accepted for
# verification only. Rotating without this logs every user out at once and
# makes auth flap across replicas mid-rollout. Rotate by moving the current
# key here, setting a new one above, deploying, then removing this entry
# after JWT_REFRESH_EXPIRY_DAYS have passed.
# JWT_SECRET_KEY_PREVIOUS=

# Distinguishes this deployment from your other environments. Required if
# users can have two environments open in one browser — otherwise both use
# the same cookie names and silently evict each other's session.
# AUTH_ENVIRONMENT_ID=production

# Admin account created on first boot (if no users exist). Change after
# first login via the UI.
ADMIN_EMAIL=admin@synodic.local
ADMIN_PASSWORD=REPLACE_ME

# ── Credential Encryption ───────────────────────────────────────────
# Fernet key for encrypting stored provider credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank for plaintext storage (not recommended for production).
CREDENTIAL_ENCRYPTION_KEY=

# ── Graph Provider Bootstrap ────────────────────────────────────────
GRAPH_PROVIDER=falkordb

# ── Worker tuning ───────────────────────────────────────────────────
WORKER_CONCURRENCY=4
MAX_CONCURRENT_PER_GRAPH=2
AGGREGATION_JOB_TIMEOUT_SECS=7200

# ── Analytics ───────────────────────────────────────────────────────
# One value, read by two roles: the controlplane warms the analytics
# documents on this cadence, and every web process snaps its analytics
# windows to the same grid. docker-compose interpolates this single variable
# into both services precisely so they cannot drift — set it here, not per
# service, or the warmer ends up writing entries no reader asks for.
ANALYTICS_WARM_INTERVAL_SECONDS=300
# Controlplane-only (the sweep is gated on the scheduler role).
# product_events takes a row per view open, lineage trace and graph search,
# so it grows with usage. Clamped to >= 365 so a year-long chart cannot be
# made to lie by shortening this.
PRODUCT_EVENT_RETENTION_DAYS=400

# ── CORS (change to your actual domain) ─────────────────────────────
# Example for public hostname:
#   CORS_ALLOWED_ORIGINS=https://synodic.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3080

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Branding (white-label app identity) ─────────────────────────────
# Seed the per-deployment brand. These are the defaults; an admin can
# override any of them live through Admin → Branding (DB-backed).
# APP_BRAND_NAME="Acme Lineage"
# APP_BRAND_SHORT_NAME="AcmeLineage"
# APP_BRAND_DESCRIPTION="Your data, mapped end to end"
# APP_BRAND_ACCENT_COLOR="#0ea5e9"
# APP_BRAND_LOGO_URL="https://cdn.acme.com/logo.svg"
# APP_BRAND_FAVICON_URL="https://cdn.acme.com/favicon.ico"
# APP_BRAND_COPYRIGHT="© 2026 Acme Corp"
# APP_BRAND_SUPPORT_EMAIL="support@acme.com"
# APP_BRAND_LOGIN_TAGLINE="Sign in to Acme Lineage"
