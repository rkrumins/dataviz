# ══════════════════════════════════════════════════════════════════════
# Synodic — Local Dev Env Template
# ══════════════════════════════════════════════════════════════════════
# Copy to .env.dev and sourced by ./dev.sh:
#   cp .env.example .env.dev
#   ./dev.sh
#
# Format: KEY=VALUE (no `export` keyword — dev.sh auto-exports).
# This file is safe to check in. .env.dev is gitignored.
# ══════════════════════════════════════════════════════════════════════

LOCAL_DEV_FALKORDB_OVERRIDE=true

# ── Postgres (shared by docker-compose.dev.yml and the backend) ──────
POSTGRES_USER=synodic
POSTGRES_PASSWORD=synodic
POSTGRES_DB=synodic
POSTGRES_PORT=5432

# ── Redis (aggregation message broker) ──────────────────────────────
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ── FalkorDB (graph database) ───────────────────────────────────────
FALKORDB_PORT=6379
FALKORDB_UI_PORT=3000
FALKORDB_HOST=localhost
FALKORDB_GRAPH_NAME=nexus_lineage
# Instance-level memory ceiling for the FalkorDB container (compose files
# pass it via REDIS_ARGS with --maxmemory-policy noeviction, so writes fail
# loudly at the ceiling instead of the container being OOM-killed). Size it
# ~75% of the container's memory limit.
FALKORDB_MAXMEMORY=4gb

# ── FalkorDB connection topology (standalone / Sentinel / Cluster) ──
# Default is standalone (FALKORDB_HOST:FALKORDB_PORT above). For HA or
# multi-shard deployments set the mode + endpoints below. These are the
# PROCESS-WIDE fallback; a single provider can override them per-provider
# via its record's extra_config.falkordbConnection (same shape), which is
# preferred when different providers use different topologies.
#
# NOTE: a single FalkorDB graph key lives on ONE Redis node — Cluster mode
# does NOT shard one graph. It provides HA + routes DIFFERENT graphs to
# their owning shards; the client is routed to the node owning the graph
# key. In Cluster mode set CACHE_REDIS_URL to a dedicated Redis (the
# ancestor/idempotency cache uses cross-slot ops); otherwise the provider
# runs cache-disabled (correct, slower).
#
# FALKORDB_MODE=standalone            # standalone | sentinel | cluster
# FALKORDB_SENTINEL_MASTER=mymaster   # sentinel: monitored master name
# FALKORDB_SENTINEL_NODES=s1:26379,s2:26379,s3:26379   # sentinel endpoints
# FALKORDB_CLUSTER_NODES=n1:6379,n2:6379,n3:6379       # cluster seed nodes

# ── Host resolution (laptop ↔ Docker) ───────────────────────────────
# A provider record stores a host (e.g. `localhost` or the Docker service
# name `falkordb`). The right value depends on WHERE the backend runs:
#   • Backend on the laptop, FalkorDB in Docker → a stored `falkordb` is
#     unresolvable. Set LOCAL_DEV_FALKORDB_OVERRIDE=true so FALKORDB_HOST
#     wins over the stored host.
#   • Backend IN Docker, reaching a FalkorDB on the host → a stored
#     `localhost` points at the container itself (false "down"). Set
#     FALKORDB_DOCKER_LOCALHOST_REWRITE to redirect localhost/127.0.0.1 to a
#     reachable target (host.docker.internal on Docker Desktop). Off by
#     default; only rewrites loopback hosts.
# FALKORDB_DOCKER_LOCALHOST_REWRITE=host.docker.internal

# ── Aggregation: streaming rebuild (million-edge scale) ─────────────
# The constant-memory streaming materializer. Pages leaf lineage edges on
# an indexed ID(r) cursor, flushes per-page via MERGE-on-aggKey, and is
# crash-resumable from last_cursor (no full-graph count, no in-memory pair
# accumulation), and resumes from cursor on every retry so a transient
# connection reset never restarts a large job from 0%. Default ON; set to
# "false" to roll back to the legacy accumulate-in-memory path.
# AGGREGATION_STREAMING_REBUILD_ENABLED=true
# AGGREGATION_MAX_PAIRS_PER_PAGE=200000   # safety valve for high-fan-in hubs

# Host-dev only: when running the backend / insights-service ON THE HOST
# (not in a container) against the `./dev.sh up` or `./dev.sh infra`
# FalkorDB, the provider row stores the Docker hostname `falkordb`, which
# the host cannot resolve. Set true so FALKORDB_HOST/FALKORDB_PORT above
# override the stored host for falkordb providers. NOT injected into
# compose service env, so in-container services are unaffected.
LOCAL_DEV_FALKORDB_OVERRIDE=true

# ── Backend connection strings (derived from the above) ─────────────
MANAGEMENT_DB_URL=postgresql+asyncpg://synodic:synodic@localhost:5432/synodic

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
ADMIN_EMAIL=admin@nexuslineage.local
ADMIN_PASSWORD=admin123

# ── Graph Provider Bootstrap ────────────────────────────────────────
GRAPH_PROVIDER=falkordb

# ── Credential Encryption ───────────────────────────────────────────
# CREDENTIAL_ENCRYPTION_KEY=   # Fernet key; omit for plaintext in dev

# ── CORS ────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3080,http://localhost:5173,http://localhost:3000

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Timeouts (backend) ──────────────────────────────────────────────
# All values centralised in backend/app/config/resilience.py. Override
# any of them here without code changes; defaults match the file.
# TRACE_TIMEOUT_SECS=60                # outer budget for /trace + /trace/expand
# HTTP_TIMEOUT_TRACE_SECS=60           # ASGI middleware budget for trace routes
# HTTP_TIMEOUT_GRAPH_SECS=15           # generic /graph/* routes
# HTTP_TIMEOUT_AGGREGATION_SECS=45     # /edges/aggregated + /aggregation/*
# HTTP_TIMEOUT_DEFAULT_SECS=30         # fallback for any other endpoint
# FALKORDB_QUERY_TIMEOUT=5             # default per-query read deadline
# FALKORDB_WRITE_TIMEOUT=15            # default per-query write deadline
# FALKORDB_CHILDREN_QUERY_TIMEOUT=15   # get_children / get_children_with_edges
# FALKORDB_EDGES_BETWEEN_TIMEOUT=40    # /edges/between urn-set edge resolve

# ── Timeouts (frontend, via Vite — ms, not seconds) ─────────────────
# Centralised in frontend/src/config/timeouts.ts. Per-call overrides
# live next to the call site (e.g. RemoteGraphProvider.getAggregatedEdges).
# VITE_TIMEOUT_DEFAULT_MS=30000        # generic fetch wrapper default
# VITE_TIMEOUT_TRACE_MS=60000          # /trace/v2 + /trace/expand
# VITE_TIMEOUT_GET_CHILDREN_MS=30000   # /nodes/:urn/children(-with-edges)
# VITE_TIMEOUT_AGGREGATED_EDGES_MS=45000  # /edges/aggregated
# VITE_TIMEOUT_EDGES_BETWEEN_MS=45000     # /edges/between (urn-set edge fetch)
# VITE_TIMEOUT_PROVIDER_HEALTH_MS=30000   # /health/providers + per-provider /test

# ── Branding (white-label app identity) ─────────────────────────────
# These seed the application_branding singleton on first migration and
# act as the default for any value not set through Admin → Branding.
# Leave unset to keep the stock product identity. Logo/favicon here are
# URLs only (uploads are managed through the admin UI). Defaults shown.
# APP_BRAND_NAME="Nexus Lineage"               # full product name
# APP_BRAND_SHORT_NAME="NexusLineage"          # compact name (header)
# APP_BRAND_DESCRIPTION="Interactive Data Lineage Visualization"
# APP_BRAND_ACCENT_COLOR="#6366f1"             # primary accent (hex)
# APP_BRAND_LOGO_URL=""                        # hosted logo image URL
# APP_BRAND_FAVICON_URL="/nexus-icon.svg"      # browser tab icon URL
# APP_BRAND_COPYRIGHT="© 2026 Nexus Lineage"   # footer/legal text
# APP_BRAND_SUPPORT_EMAIL=""                   # shown in help surfaces
# APP_BRAND_LOGIN_TAGLINE="Sign in to continue"
