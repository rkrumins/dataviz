# ══════════════════════════════════════════════════════════════════════
# Synodic — Local Dev Env Template
# ══════════════════════════════════════════════════════════════════════
# Copy to .env.dev and sourced by ./dev.sh:
#   cp .env.example .env.dev
#   ./dev.sh
#
# Format: KEY=VALUE (no `export` keyword — dev.sh auto-exports).
# This file is safe to check in. .env.dev is gitignored.
# ══════════════════════════════════════════════════════════════════════

LOCAL_DEV_FALKORDB_OVERRIDE=true

# ── Postgres (shared by docker-compose.dev.yml and the backend) ──────
POSTGRES_USER=synodic
POSTGRES_PASSWORD=synodic
POSTGRES_DB=synodic
POSTGRES_PORT=5432

# ── Redis (aggregation message broker) ──────────────────────────────
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ── FalkorDB (graph database) ───────────────────────────────────────
FALKORDB_PORT=6379
FALKORDB_UI_PORT=3000
FALKORDB_HOST=localhost
FALKORDB_GRAPH_NAME=nexus_lineage
# Instance-level memory ceiling for the FalkorDB container (compose files
# pass it via REDIS_ARGS with --maxmemory-policy noeviction, so writes fail
# loudly at the ceiling instead of the container being OOM-killed).
# SIZE IT ABOVE YOUR EXISTING DATASET: check
#   docker exec <falkordb> redis-cli INFO memory | grep used_memory_human
# and leave ~40% headroom — a ceiling BELOW current usage denies EVERY
# write ("OutOfMemoryError: command not allowed when used memory >
# 'maxmemory'"). Raise live without a restart via
#   redis-cli CONFIG SET maxmemory <n>gb
FALKORDB_MAXMEMORY=12gb

# ── FalkorDB connection topology (standalone / Sentinel / Cluster) ──
# Default is standalone (FALKORDB_HOST:FALKORDB_PORT above). For HA or
# multi-shard deployments set the mode + endpoints below. These are the
# PROCESS-WIDE fallback; a single provider can override them per-provider
# via its record's extra_config.falkordbConnection (same shape), which is
# preferred when different providers use different topologies.
#
# NOTE: a single FalkorDB graph key lives on ONE Redis node — Cluster mode
# does NOT shard one graph. It provides HA + routes DIFFERENT graphs to
# their owning shards; the client is routed to the node owning the graph
# key. In Cluster mode set CACHE_REDIS_URL to a dedicated Redis (the
# ancestor/idempotency cache uses cross-slot ops); otherwise the provider
# runs cache-disabled (correct, slower).
#
# FALKORDB_MODE=standalone            # standalone | sentinel | cluster
# FALKORDB_SENTINEL_MASTER=mymaster   # sentinel: monitored master name
# FALKORDB_SENTINEL_NODES=s1:26379,s2:26379,s3:26379   # sentinel endpoints
# FALKORDB_CLUSTER_NODES=n1:6379,n2:6379,n3:6379       # cluster seed nodes
#
# Sentinel-daemon TLS: the daemons inherit the data-plane FALKORDB_TLS_*
# settings by default ("TLS everywhere" needs nothing extra). Set this only
# to force it on/off independently (e.g. TLS data plane + plaintext
# sentinels → false). Cert paths ride extra_config.falkordbConnection
# sentinel.tls for per-provider splits.
# FALKORDB_SENTINEL_TLS_ENABLED=true
#
# Cross-cluster address remap: Redis announces the addresses IT knows (the
# cluster slot map, MOVED redirects, sentinel discover-master) — pod IPs a
# client in ANOTHER GKE cluster cannot dial. Map each announced address to a
# reachable endpoint ("from[:port]=to[:port]" CSV; exact host:port beats a
# host-only entry; absent → no-op). Per-provider equivalent:
# extra_config.falkordbConnection.addressRemap.
# FALKORDB_ADDRESS_REMAP=10.0.0.5:6379=graph-0.example.com:6379,10.0.0.6:6379=graph-1.example.com:6379

# ── Host resolution (laptop ↔ Docker) ───────────────────────────────
# A provider record stores a host (e.g. `localhost` or the Docker service
# name `falkordb`). The right value depends on WHERE the backend runs:
#   • Backend on the laptop, FalkorDB in Docker → a stored `falkordb` is
#     unresolvable. Set LOCAL_DEV_FALKORDB_OVERRIDE=true so FALKORDB_HOST
#     wins over the stored host.
#   • Backend IN Docker, reaching a FalkorDB on the host → a stored
#     `localhost` points at the container itself (false "down"). Set
#     FALKORDB_DOCKER_LOCALHOST_REWRITE to redirect localhost/127.0.0.1 to a
#     reachable target (host.docker.internal on Docker Desktop). Off by
#     default; only rewrites loopback hosts.
# FALKORDB_DOCKER_LOCALHOST_REWRITE=host.docker.internal

# ── Aggregation: streaming rebuild (million-edge scale) ─────────────
# Host-dev only: when running the backend / insights-service ON THE HOST
# (not in a container) against the `./dev.sh up` or `./dev.sh infra`
# FalkorDB, the provider row stores the Docker hostname `falkordb`, which
# the host cannot resolve. Set true so FALKORDB_HOST/FALKORDB_PORT above
# override the stored host for falkordb providers. NOT injected into
# compose service env, so in-container services are unaffected.
LOCAL_DEV_FALKORDB_OVERRIDE=true

# ── Backend connection strings (derived from the above) ─────────────
MANAGEMENT_DB_URL=postgresql+asyncpg://synodic:synodic@localhost:5432/synodic

# ── Auth ────────────────────────────────────────────────────────────
# No default is shipped on purpose. This file used to carry
# `dev-secret-key-change-in-production`, which is 34 characters and so
# cleared the >= 32 length floor — a deployment that copied this file
# forward booted clean while signing every token with a value published
# in this repository. Startup now refuses that literal by name.
#
# Generate your own, once per environment:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Access-token lifetime. Permission claims are embedded in the token, so
# this is also how stale a live session's permissions can be: a role
# change reaches it on the next rotation, not immediately. Expiry is
# invisible to users — the SPA rotates against the refresh cookie — so
# there is no UX reason to raise it, and every minute added is a minute
# a revoked session keeps working.
JWT_EXPIRY_MINUTES=15

# Refresh-cookie lifetime: how long "stay signed in" actually lasts.
JWT_REFRESH_EXPIRY_DAYS=7

# How long a re-presented refresh token is treated as a concurrent
# refresh (two tabs, a retried POST, a lost Set-Cookie) rather than a
# stolen chain.
#
# This is a real tradeoff in both directions. At 0, rotation is strict
# and any re-presentation kills the family — which catches a thief on
# their first use, and also signs a legitimate user out of every tab
# whenever two of them happen to rotate at once. At 30, an attacker who
# has already stolen the refresh cookie and uses it within 30s of a
# legitimate rotation gets the same successor instead of tripping
# detection. Note the precondition: they must already hold an HttpOnly
# cookie. Widening this much beyond 30s buys nothing — the races it
# exists to absorb all resolve in well under a second.
REFRESH_ROTATION_GRACE_SECONDS=30

# SSO sessions must re-authenticate at the IdP this often, regardless of
# the refresh cookie's life. Local password sessions are unaffected.
SSO_SESSION_MAX_AGE_HOURS=24

# How far outside its stated validity a token we issued is still
# honoured, to absorb clock drift between replicas. Every pod both mints
# and verifies, so exp/iat/nbf are compared across two machines' clocks:
# without this, a pod a second ahead rejects a token that has not
# expired, and one a second behind rejects a token as not-yet-valid.
# The OIDC path has always allowed the same 60s for an IdP's clock.
#
# Raising it widens the window in which a revoked token is still
# accepted by exactly that much — which is why the revocation TTL below
# is derived from it. Set to 0 only if your clocks are tightly synced.
JWT_CLOCK_SKEW_LEEWAY_SECONDS=60

# Derived from JWT_EXPIRY_MINUTES + JWT_CLOCK_SKEW_LEEWAY_SECONDS + 60s
# when unset — leave it unset. Setting it below the window in which an
# access token is still accepted makes forced revocation stop taking
# effect before the token does, and the app now refuses to boot in that
# state.
# RBAC_REVOCATION_TTL_SECONDS=

# JWT issuer / audience. Change only alongside a deliberate token
# migration: every existing session fails to validate the moment these
# move.
# JWT_ISSUER=nexus-lineage
# JWT_AUDIENCE=nexus-lineage

# Session-cookie attributes. AUTH_COOKIE_SECURE=false is for plain-HTTP
# local development only. AUTH_COOKIE_DOMAIN is needed only when the API
# and the UI are on different subdomains.
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=

# Peers whose X-Forwarded-For is believed. Leave at the default unless a
# trusted proxy is the only thing that can reach the API port — with it
# unset behind a proxy, every user shares one rate-limit bucket keyed on
# the proxy's address.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Shared rate-limit storage. Without it each gunicorn worker keeps its
# own counters, so the effective limit is per-worker.
# RATELIMIT_STORAGE_URI=redis://redis:6379/1

# Rate limits. Two different jobs, so two different keys.
#
# The per-IP values are a coarse flood guard and nothing more. Behind a
# NAT or an ingress every user shares one address, so a tight cap does
# not stop an attacker (they have many addresses) while it does stop an
# office (it has one). Defaults are sized so a ~2000-seat deployment
# never reaches them during a morning sign-in rush. Real DoS handling
# belongs at the proxy.
# RATELIMIT_LOGIN_PER_IP=1000/minute
# RATELIMIT_SENSITIVE_PER_IP=200/minute

# Refresh is keyed per rotation family (one browser session), so it is
# already per-user and needs no headroom for tenant size. A session needs
# ~4 rotations an hour.
# RATELIMIT_REFRESH_PER_SESSION=30/minute

# The per-account limits are the actual security control: they key on
# the account under attack, so they hold however many addresses the
# attempts come from. Login counts FAILURES only and is cleared by a
# successful sign-in, so a legitimate user is never throttled.
# RATELIMIT_LOGIN_PER_ACCOUNT=10 per 15 minutes
# RATELIMIT_PASSWORD_RESET_PER_ACCOUNT=3/hour

# Retired signing keys, comma-separated, most-recent first. Accepted for
# VERIFICATION only — never used to sign. Rotating without this logs every
# user out the instant the new key lands, and during a rolling update pods
# holding the old and new key both serve traffic, so auth flaps
# request-to-request. To rotate: move the current key here, set the new one
# above, deploy, then drop this entry after JWT_REFRESH_EXPIRY_DAYS.
# JWT_SECRET_KEY_PREVIOUS=

# Names this deployment (dev / uat / staging). Optional, and unset behaves
# exactly as before. Set it whenever two environments can be open in the
# same browser: cookie jars are keyed by DOMAIN, not by cluster, so two
# deployments sharing the default cookie names overwrite each other's
# session even on separate clusters — signing into one logs you out of the
# other. This scopes the cookie names (nx_access_uat) and binds the
# environment into the JWT issuer.
# AUTH_ENVIRONMENT_ID=dev

ADMIN_EMAIL=admin@nexuslineage.local
ADMIN_PASSWORD=admin123

# ── Graph Provider Bootstrap ────────────────────────────────────────
GRAPH_PROVIDER=falkordb

# ── Credential Encryption ───────────────────────────────────────────
# CREDENTIAL_ENCRYPTION_KEY=   # Fernet key; omit for plaintext in dev

# ── CORS ────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3080,http://localhost:5173,http://localhost:3000

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Graph response cache (Redis) ────────────────────────────────────
# backend/app/services/graph_cache.py — response cache for hot graph
# endpoints. Defaults are safe; override only if you know why.
# GRAPH_CACHE_MAX_PAYLOAD_BYTES=8388608  # the compose stack already sets 8 MiB
#   (docker-compose.yml, every service with a cache client). Set it here only to
#   override that: the library default of 1 MiB is smaller than a wide
#   trace-closure page (~2.5 MB), which is exactly what is worth caching.
# AGGREGATION_DRIFT_AUTO_REBUILD=true     # scheduler auto-rebuilds on detected drift + reconciles stale markers; false = notify-only
# AGGREGATION_REBUILD_MIN_INTERVAL_SECS=900  # min seconds between source-changed rebuilds (throttle); 0 disables the cooldown

# ── Automatic reconciliation ────────────────────────────────────────
# Detects a data source whose :AGGREGATED rollups no longer match its
# data — wiped by an external reload, never built, or drifted — and
# rebuilds it. Decided entirely from the counts the stats service already
# collects, so a check costs nothing on the graph. All of these are
# fallbacks only: a persisted global (Ingestion → Freshness → Cadence &
# reconciliation) and a per-source override take precedence.
# See docs/features/aggregation-reconciliation.md.
# AGGREGATION_RECONCILE_ENABLED=true            # master switch for the sweep
# AGGREGATION_RECONCILE_INTERVAL_SECS=3600      # how often each source is checked (floor 30)
# AGGREGATION_RECONCILE_MAX_ACTIONS=10          # rebuilds one sweep may queue; the rest wait for the next
# AGGREGATION_RECONCILE_SHRINK_TOLERANCE_PCT=10 # how far rollups may fall below the last build before it reads as shrunk
# AGGREGATION_RECONCILE_STATS_MAX_AGE_SECS=2700 # older statistics are not trusted as evidence (3x the stats poll interval)
# AGGREGATION_RECONCILE_BREAKER_CAP=3           # consecutive rebuilds before a source is suspended for a human
# AGGREGATION_RECONCILE_SCAN_TIMEOUT=3          # ceiling on the fleet-wide stale-marker Redis scan

# ── Drift probe ─────────────────────────────────────────────────────
# What makes the sweep above timely. A probe reads FalkorDB's label and
# relation-type counters (constant time, ~1ms) rather than scanning the
# graph the way the stats poll must, so it can run on a 60s cadence where
# STATS_DEFAULT_INTERVAL_SECS has to stay at 900. The interval is the
# self-detection SLO: a source nobody notifies us about is noticed within
# roughly this window plus one sweep tick. Same precedence as above — the
# persisted global and per-source override win over these.
# AGGREGATION_PROBE_ENABLED=true                # master switch for active probing
# AGGREGATION_PROBE_INTERVAL_SECS=60            # how often each source's counts are re-read
# AGGREGATION_PROBE_BATCH_CAP=200               # probes enqueued per tick; the rest wait for the next
# STATS_PROBE_CONCURRENCY=4                     # probe worker lane budget (stats-service)
# STATS_PROBE_TIMEOUT_SECS=20                   # per-probe ceiling; fixed, never size-adaptive
# STATS_PROBE_DEDUP_TTL_SECS=90                 # probe claim TTL; only has to outlive one probe

# ── Counts history ──────────────────────────────────────────────────
# The append-only record behind "how many entities did this source have
# last Tuesday, and which label lost them". Captured inside the same
# write that refreshes data_source_stats, so every collection lane (the
# 60s probe above, the stats poll, the deep profile, the sweep, app write
# paths) feeds one series and no extra provider I/O is added anywhere.
#
# Capture is CHANGE-GATED: a row is written when the counts digest moves,
# and otherwise at most once per heartbeat. Without that, the 60s probe
# alone would write ~43k rows per source per month describing a graph that
# mostly did not change. The heartbeat is what makes an idle month look
# idle rather than missing.
#
# Retention has two passes, and they cover different failure modes: the
# age cutoff bounds how far back the table goes, the per-source cap bounds
# how much ONE source thrashing under a broken loader can contribute.
# Both can be overridden live by an admin (Platform settings) — these are
# the defaults that apply when nothing is persisted.
# INSIGHTS_HISTORY_ENABLED=true                  # master switch for capture
# INSIGHTS_HISTORY_HEARTBEAT_SECS=3600           # continuity row when nothing changed
# INSIGHTS_HISTORY_RETENTION_DAYS=90             # age cutoff (the product floor is 30, with headroom)
# INSIGHTS_HISTORY_MAX_ROWS_PER_SOURCE=5000      # per-source row cap, applied alongside the age cutoff
# INSIGHTS_HISTORY_PURGE_INTERVAL_SECS=3600      # how often the purge runs (stats-service)

# ── Counts anomaly alerting ─────────────────────────────────────────
# Turns the history from something you go and look at into something that
# tells you. Evaluation is a SWEEP in the insights service, not a hook on the
# write: "unusual" is measured against the source's own median movement over a
# window, so judging at capture time would put a range scan on the 60s probe
# path and would run inside the web tier too.
#
# Delivery is the in-app bell (data source managers + globally bound
# system:admin), unread-deduped per source. The alert itself is recorded in
# data_source_count_alerts and readable at /api/v1/admin/insights/alerts.
#
# The severity floor defaults to `severe` on purpose. An alerting default that
# fires too eagerly gets muted, and a muted alert is worth less than none —
# people stop reading it but still believe something is watching.
# INSIGHTS_ALERTS_ENABLED=true                    # master switch for evaluation
# INSIGHTS_ALERT_MIN_SEVERITY=severe              # severe (>=8x usual) | notable (>=3x)
#   A fourth tier, `critical`, fires on a drop taking >=90% of the graph and
#   IGNORES this floor. It is measured against the graph rather than against
#   the source's churn, because a source with large routine movement can lose
#   everything without the loss reaching 8x its own median.
# INSIGHTS_ALERT_COOLDOWN_SECS=21600              # at most one alert per source per this
# INSIGHTS_ALERT_INTERVAL_SECS=900                # how often movements are judged

# ── Timeouts (backend) ──────────────────────────────────────────────
# All values centralised in backend/app/config/resilience.py. Override
# any of them here without code changes; defaults match the file.
# TRACE_TIMEOUT_SECS=60                # outer budget for /trace + /trace/expand
# HTTP_TIMEOUT_TRACE_SECS=60           # ASGI middleware budget for trace routes
# HTTP_TIMEOUT_GRAPH_SECS=15           # generic /graph/* routes
# HTTP_TIMEOUT_AGGREGATION_SECS=45     # /edges/aggregated + /aggregation/*
# HTTP_TIMEOUT_DEFAULT_SECS=30         # fallback for any other endpoint
# FALKORDB_QUERY_TIMEOUT=5             # default per-query read deadline
# FALKORDB_WRITE_TIMEOUT=15            # default per-query write deadline
# FALKORDB_CHILDREN_QUERY_TIMEOUT=15   # get_children / get_children_with_edges
# FALKORDB_EDGES_BETWEEN_TIMEOUT=40    # /edges/between urn-set edge resolve
# FALKORDB_TOP_LEVEL_QUERY_TIMEOUT=30  # /nodes/top-level page query
# FALKORDB_TOP_LEVEL_COUNT_TIMEOUT=5   # /nodes/top-level count (best-effort; miss => totalCount null)
# FALKORDB_SERVER_TIMEOUT_MAX_MS=180000  # MUST match TIMEOUT_MAX in FALKORDB_ARGS; per-query timeouts are clamped to it
# PROVIDER_INSTANTIATION_TIMEOUT_SECS=10 # provider connect+preflight budget (raise if instantiation breaker trips under load)
# TOP_LEVEL_MATERIALIZE_LIMIT=1000     # nodes captured per top-level materialization (complete window => filtered serving)
# TOP_LEVEL_SERVE_MIN_NODES=100000     # node-count floor for serving materialized top-level pages

# ── Timeouts (frontend, via Vite — ms, not seconds) ─────────────────
# Centralised in frontend/src/config/timeouts.ts. Per-call overrides
# live next to the call site (e.g. RemoteGraphProvider.getAggregatedEdges).
# VITE_TIMEOUT_DEFAULT_MS=30000        # generic fetch wrapper default
# VITE_TIMEOUT_TRACE_MS=60000          # /trace/v2 + /trace/expand
# VITE_TIMEOUT_GET_CHILDREN_MS=30000   # /nodes/:urn/children(-with-edges)
# VITE_TIMEOUT_TOP_LEVEL_MS=45000      # /nodes/top-level (must exceed backend page+count budgets)
# VITE_TIMEOUT_AGGREGATED_EDGES_MS=45000  # /edges/aggregated
# VITE_TIMEOUT_EDGES_BETWEEN_MS=45000     # /edges/between (urn-set edge fetch)
# VITE_TIMEOUT_PROVIDER_HEALTH_MS=30000   # /health/providers + per-provider /test

# ── Branding (white-label app identity) ─────────────────────────────
# These seed the application_branding singleton on first migration and
# act as the default for any value not set through Admin → Branding.
# Leave unset to keep the stock product identity. Logo/favicon here are
# URLs only (uploads are managed through the admin UI). Defaults shown.
# APP_BRAND_NAME="Context Visualization Platform"   # full product name
# APP_BRAND_SHORT_NAME="CVP"                    # compact name (header)
# APP_BRAND_DESCRIPTION="Interactive Data Lineage Visualization"
# APP_BRAND_ACCENT_COLOR="#6366f1"             # primary accent (hex)
# APP_BRAND_LOGO_URL=""                        # hosted logo image URL
# APP_BRAND_FAVICON_URL="/nexus-icon.svg"      # browser tab icon URL
# APP_BRAND_COPYRIGHT="© 2026 Context Visualization Platform"   # footer/legal text
# APP_BRAND_SUPPORT_EMAIL=""                   # shown in help surfaces
# APP_BRAND_LOGIN_TAGLINE="Sign in to continue"
