# ── Synodic Visualization Service ──────────────────────────────────────
# Primary backend: auth, workspace management, graph queries, ontology.
# Serves on port 8000. Requires Management DB + graph provider at runtime.
# ──────────────────────────────────────────────────────────────────────
FROM python:3.13-slim AS base

WORKDIR /app

# Runtime libs for pre-built wheels (no compiler needed). xmlsec1 +
# libxmlsec1-dev are required by python3-saml for assertion signature
# verification; libxml2-dev pulls in the canonicalisation/xpath bits
# python3-saml uses for strict-mode parsing.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libffi-dev libpq-dev curl \
        libxml2-dev libxmlsec1-dev libxmlsec1-openssl xmlsec1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (cached layer)
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ /app/backend/

# Non-root user for security
RUN addgroup --system synodic && adduser --system --ingroup synodic synodic
USER synodic

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD curl -sf http://localhost:8000/health || exit 1

# Gunicorn with Uvicorn async workers.
# Worker count is env-driven so it can be tuned per-deployment without
# rebuilding the image (e.g., set GUNICORN_WORKERS=4 in Helm values).
# Tune based on available CPU cores (2 * CPU + 1 is a common formula).
# Default 4 (not 2): response serialization (Pydantic → JSON → gzip) is
# CPU-bound ON the event loop, so with 2 workers two concurrent large
# graph responses wedged every loop — including /health, which is what
# tripped the frontend's "backend unreachable" banner. The in-process
# projector is single-flight per graph via a Postgres advisory lock
# (services/versioning/projection.py:project_graph), so extra workers
# don't duplicate background projection work.
ENV GUNICORN_WORKERS=4 \
    GUNICORN_TIMEOUT=120 \
    GUNICORN_GRACEFUL_TIMEOUT=30

CMD ["sh", "-c", "exec gunicorn backend.app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers ${GUNICORN_WORKERS} \
    --bind 0.0.0.0:8000 \
    --timeout ${GUNICORN_TIMEOUT} \
    --graceful-timeout ${GUNICORN_GRACEFUL_TIMEOUT} \
    --access-logfile -"]
