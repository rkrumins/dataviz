    {
      "name": "glob-star-matches-newlines",
      "summary": "CRITERIA glob: * matches newlines too (DOTALL), while anchoring still rejects a trailing newline after the literal end.",
      "view": {
        "content": { "entityScope": "all" },
        "layout": {
          "referenceLayout": {
            "layers": [
              {
                "id": "a",
                "name": "A",
                "order": 0,
                "entityTypes": [],
                "rules": [{ "id": "g", "priority": 1, "urnPattern": "urn:x:*:end" }]
              }
            ],
            "assignments": {}
          }
        }
      },
      "nodes": [{ "urn": "urn:x:a\nb:end" }, { "urn": "urn:x:a:end\n" }, { "urn": "urn:x::end" }],
      "expect": {
        "urn:x:a\nb:end": { "layerId": "a", "source": "rule", "ruleId": "g" },
        "urn:x:a:end\n": { "source": "none" },
        "urn:x::end": { "layerId": "a", "source": "rule", "ruleId": "g" }
      }
    },
