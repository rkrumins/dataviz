# Landing-site branding — build-time defaults (mirror the backend APP_BRAND_*
# defaults). Override per client at build time, e.g.
#   VITE_BRAND_NAME="Acme Lineage" npm run build
# These feed both src/config/brand.ts and the %VITE_BRAND_*% tokens in index.html.
VITE_BRAND_NAME=Nexus Lineage
VITE_BRAND_SHORT_NAME=NexusLineage
VITE_BRAND_DESCRIPTION=Interactive Data Lineage Visualization
