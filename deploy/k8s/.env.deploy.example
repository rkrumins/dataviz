# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Synodic GKE Deployment Configuration
#
# This file is auto-generated by: ./deploy.sh setup
# Copy to .env.deploy and fill in values, or run the setup wizard.
#
# DO NOT COMMIT .env.deploy — it contains secrets.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# GCP
PROJECT_ID=my-gcp-project
REGION=us-central1
REGISTRY=us-central1-docker.pkg.dev/my-gcp-project/synodic
CLUSTER_NAME=synodic-cluster

# Domain (must match DNS A record pointing to the reserved static IP)
DOMAIN=synodic.example.com

# Secrets (auto-generated by ./deploy.sh setup — do not reuse across environments)
POSTGRES_PASSWORD=CHANGE_ME_random_32_chars
JWT_SECRET_KEY=CHANGE_ME_random_64_chars
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_fernet_key
ADMIN_EMAIL=admin@synodic.local
ADMIN_PASSWORD=CHANGE_ME_random_16_chars

# Caching — keep separate from FalkorDB
# REDIS_URL: dedicated Redis for job dispatch, event propagation, and
#            GraphCache (children-with-edges, aggregated-edges).
# CACHE_REDIS_URL: dedicated Redis for the FalkorDB provider's ancestor
#            chain + URN-label caches. MUST NOT point at the FalkorDB
#            instance — co-location means a FalkorDB outage also wipes
#            caching, defeating the purpose. base/configmaps/common-config
#            uses DB 1 on the same dedicated Redis service to keep traffic
#            namespaced.

# ── Managed data tier (production overlay only) ─────────────────────
# `deploy.sh deploy production` uses overlays/production, which REPLACES the
# in-cluster postgres/redis with Cloud SQL + Memorystore and sets
# DB_POOLER_MODE=transaction. Provide their PRIVATE IPs below. The GKE cluster
# must be VPC-native with private access to the services VPC (required for
# Memorystore regardless), so these are reachable directly — no sidecar.
# dev/staging ignore these and use the in-cluster stores.
#   FalkorDB is NOT managed — it stays self-managed on GKE (a single base
#   StatefulSet by default; scale to the 3-shard Redis Cluster per the
#   launch-scale spec §7 when you need it).
DB_HOST=CHANGE_ME_cloudsql_private_ip            # Cloud SQL private IP (or 127.0.0.1 if you add the Auth Proxy sidecar)
REDIS_COORD_HOST=CHANGE_ME_memorystore_coord_ip  # Memorystore (coordination) private IP — noeviction + AOF
REDIS_CACHE_HOST=CHANGE_ME_memorystore_cache_ip  # Memorystore (cache) private IP — allkeys-lru

# FalkorDB DR (launch-scale §8): 6-hourly RDB snapshot → multi-region GCS. The
# snapshots only SHORTEN a rebuild — graphs are always reseedable from Cloud SQL,
# which is why a 6h cadence is enough. Bucket + Workload Identity setup and the
# restore procedure: deploy/k8s/overlays/production/resources/falkordb-dr-backup.yaml
# and docs/FALKORDB_DR_RUNBOOK.md.
FALKORDB_BACKUP_BUCKET=CHANGE_ME_gcs_bucket_name  # e.g. synodic-falkordb-dr (multi-region)
