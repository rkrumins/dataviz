# Landing-site branding.
#
# These VITE_BRAND_* values are the BUILD-TIME defaults / fallback — used for
# first paint, the %VITE_BRAND_*% SEO tokens in index.html, and whenever the
# runtime branding fetch is unavailable (standalone deploy with no backend).
# Override per client at build time, e.g.  VITE_BRAND_NAME="Acme Lineage" npm run build
VITE_BRAND_NAME=Nexus Lineage
VITE_BRAND_SHORT_NAME=NexusLineage
VITE_BRAND_DESCRIPTION=Interactive Data Lineage Visualization

# At RUNTIME the site also fetches the live brand from the backend's public
# GET /api/v1/branding (so a system-admin's changes propagate). Default is the
# same origin. To reach an API on another origin, set the full base URL here
# (and add this origin to the backend CORS_ALLOWED_ORIGINS). Leave unset for
# same-origin / standalone deployments.
# VITE_BRANDING_API_URL=https://app.example.com/api/v1/branding
