{
  "cases": [
    {
      "name": "glob-star-matches-any-run",
      "summary": "CRITERIA glob: * matches any run, including the empty one and DataHub-style URNs with parentheses and commas.",
      "view": {
        "content": { "entityScope": "all" },
        "layout": {
          "referenceLayout": {
            "layers": [
              {
                "id": "a",
                "name": "A",
                "order": 0,
                "entityTypes": [],
                "rules": [{ "id": "g", "priority": 1, "urnPattern": "urn:li:dataset:*" }]
              }
            ],
            "assignments": {}
          }
        }
      },
      "nodes": [
        { "urn": "urn:li:dataset:(urn:li:dataPlatform:hive,db.t,PROD)" },
        { "urn": "urn:li:dataset:" },
        { "urn": "urn:li:datasetx" }
      ],
      "expect": {
        "urn:li:dataset:(urn:li:dataPlatform:hive,db.t,PROD)": { "layerId": "a", "source": "rule", "ruleId": "g" },
        "urn:li:dataset:": { "layerId": "a", "source": "rule", "ruleId": "g" },
        "urn:li:datasetx": { "source": "none" }
      }
    },
    {
      "name": "glob-is-anchored",
      "summary": "CRITERIA glob: the pattern must match the whole URN, at both ends.",
      "view": {
        "content": { "entityScope": "all" },
        "layout": {
          "referenceLayout": {
            "layers": [
              {
                "id": "a",
                "name": "A",
                "order": 0,
                "entityTypes": [],
                "rules": [{ "id": "g", "priority": 1, "urnPattern": "dataset*" }]
              },
              {
                "id": "b",
                "name": "B",
                "order": 1,
                "entityTypes": [],
                "rules": [{ "id": "g2", "priority": 1, "urnPattern": "urn:*:x" }]
              }
            ],
            "assignments": {}
          }
        }
      },
      "nodes": [
        { "urn": "urn:li:dataset:y" },
        { "urn": "dataset:y" },
        { "urn": "urn:a:x" },
        { "urn": "urn:a:xy" },
        { "urn": "my:urn:a:x" }
      ],
      "expect": {
        "urn:li:dataset:y": { "source": "none" },
        "dataset:y": { "layerId": "a", "source": "rule", "ruleId": "g" },
        "urn:a:x": { "layerId": "b", "source": "rule", "ruleId": "g2" },
        "urn:a:xy": { "source": "none" },
        "my:urn:a:x": { "source": "none" }
      }
    },
    {
      "name": "glob-question-is-one-code-point",
      "summary": "CRITERIA glob: ? matches exactly one code point, an astral character included, never zero or two.",
      "view": {
        "content": { "entityScope": "all" },
        "layout": {
          "referenceLayout": {
            "layers": [
              {
                "id": "a",
                "name": "A",
                "order": 0,
                "entityTypes": [],
                "rules": [{ "id": "g", "priority": 1, "urnPattern": "urn:a?c" }]
              }
            ],
            "assignments": {}
          }
        }
      },
      "nodes": [{ "urn": "urn:abc" }, { "urn": "urn:ac" }, { "urn": "urn:a\ud83d\ude00c" }, { "urn": "urn:abbc" }],
      "expect": {
        "urn:abc": { "layerId": "a", "source": "rule", "ruleId": "g" },
        "urn:ac": { "source": "none" },
        "urn:a\ud83d\ude00c": { "layerId": "a", "source": "rule", "ruleId": "g" },
        "urn:abbc": { "source": "none" }
      }
    },
    {
      "name": "glob-regex-characters-are-literal",
      "summary": "CRITERIA glob: every character other than * and ? is literal, regex metacharacters . + ( ) [ ] | $ ^ included.",
      "view": {
        "content": { "entityScope": "all" },
        "layout": {
          "referenceLayout": {
            "layers": [
              {
                "id": "a",
                "name": "A",
                "order": 0,
                "entityTypes": [],
                "rules": [{ "id": "g", "priority": 1, "urnPattern": "urn:a.b+(c)[d]|e$^*" }]
              }
            ],
            "assignments": {}
          }
        }
      },
      "nodes": [
        { "urn": "urn:a.b+(c)[d]|e$^tail" },
        { "urn": "urn:a.b+(c)[d]|e$^" },
        { "urn": "urn:aXb+(c)[d]|e$^" },
        { "urn": "urn:a.bb+(c)[d]|e$^" }
      ],
      "expect": {
        "urn:a.b+(c)[d]|e$^tail": { "layerId": "a", "source": "rule", "ruleId": "g" },
        "urn:a.b+(c)[d]|e$^": { "layerId": "a", "source": "rule", "ruleId": "g" },
        "urn:aXb+(c)[d]|e$^": { "source": "none" },
        "urn:a.bb+(c)[d]|e$^": { "source": "none" }
      }
    },
